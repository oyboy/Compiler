fn partition(int arr[], int low, int high) -> int {
    int pivot = arr[high];
    int i = low - 1;

    for (int j = low; j < high; j = j + 1) {
        if (arr[j] < pivot) {
            i = i + 1;
            int temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
    }
    int temp2 = arr[i + 1];
    arr[i + 1] = arr[high];
    arr[high] = temp2;
    return i + 1;
}

fn quicksort(int arr[], int low, int high) -> void {
    if (low < high) {
        int pi = partition(arr, low, high);
        quicksort(arr, low, pi - 1);
        quicksort(arr, pi + 1, high);
    }
}

fn main() -> int {
    int arr[6];
    arr[0] = 10;
    arr[1] = 7;
    arr[2] = 8;
    arr[3] = 9;
    arr[4] = 1;
    arr[5] = 5;

    print("Initial array:");
    for (int i = 0; i < 6; i = i + 1) {
        print(arr[i]);
    }

    quicksort(arr, 0, 5);

    print("Sorted array:");
    for (int k = 0; k < 6; k = k + 1) {
        print(arr[k]);
    }

    return 0;
}