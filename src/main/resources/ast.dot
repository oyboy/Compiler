digraph AST {
  rankdir=TB;
  node [shape=box, fontname="Courier", fontsize=10];

  n0 [label="Program", style=filled, fillcolor="lightblue"];
  n1 [label="VarDecl\nint x", style=filled, fillcolor="#FFFFCC"];
