fn fib(int n, int memo[100]) -> int {
    if (n <= 1) {
        return n;
    }

    if (memo[n] != -1) {
        return memo[n];
    }

    int value;
    value = fib(n - 1, memo) + fib(n - 2, memo);

    memo[n] = value;
    return value;
}

fn factorial(int n) -> int {
    if (n <= 1) {
        return 1;
    }

    return n * factorial(n - 1);
}

fn bubble_sort(int arr[10], int size) -> void {
    for (int i = 0; i < size; i = i + 1) {
        for (int j = 0; j < size - 1; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                int temp;
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

fn print_array(int arr[10], int size) -> void {
    for (int i = 0; i < size; i = i + 1) {
        print(arr[i]);
    }
}

fn math_demo() -> void {
    print("Math demo");

    print(pow(2.0, 8.0));
    print(sqrt(144.0));
    print(sin(30.0));
    print(cos(30.0));

    if (false) {
        print("This code is never executed");
    }
}

fn benchmark_demo() -> void {
    int sum;
    sum = 0;

    for (int i = 0; i < 1000; i = i + 1) {
        sum = sum + i;
    }

    print(sum);
}

fn main() -> int {
    print("Initial array");

    int arr[10];

    arr[0] = 50;
    arr[1] = 20;
    arr[2] = 40;
    arr[3] = 10;
    arr[4] = 30;
    arr[5] = 90;
    arr[6] = 70;
    arr[7] = 60;
    arr[8] = 80;
    arr[9] = 0;

    print_array(arr, 10);

    bubble_sort(arr, 10);

    print("Sorted array");

    print_array(arr, 10);

    print("Factorial of 5");

    print(factorial(5));

    int memo[100];

    for (int i = 0; i < 100; i = i + 1) {
        memo[i] = -1;
    }

    print("Fibonacci of 10");

    print(fib(10, memo));

    int x;

    printf("Enter a number: ");
    scanf("%d", x);

    printf("You entered: %d\n", x);
    printf("sin(x) = %f\n", sin(x));
    printf("cos(x) = %f\n", cos(x));

    math_demo();

    benchmark_demo();

    test();

    return 0;
}

fn unreachable_function() -> void {
    print("Unused function");
}

fn test() -> void {
    int n = 10;
    pointer arr = malloc(n * 8);

    int i = 0;
    while (i < n) {
        arr[i] = i * 2;
        i = i + 1;
    }

    free(arr);
}