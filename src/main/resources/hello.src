fn main() -> int {
    int arr[5];
    arr[0] = 50;
    arr[1] = 20;
    arr[2] = 40;
    arr[3] = 10;
    arr[4] = 30;

    for (int i = 0; i < 5; i = i + 1) {
        for (int j = 0; j < 4; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    for (int i = 0; i < 5; i = i + 1) {
        print(arr[i]);
    }

    return 0;
}