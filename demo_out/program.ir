    JUMP_IF t0, L_true
    JUMP L_endif
L_true:
    RETURN 1
L_endif:
    t1 = SUB n, 1
    PARAM 0, t1
    t2 = CALL factorial, 1
    t3 = MUL n, t2
    RETURN t3

